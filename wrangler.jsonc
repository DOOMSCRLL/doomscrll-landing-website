{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "doomscrll-landing-website",
  "compatibility_date": "2026-05-18",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "d4546f7ee709493e87c14b79c1ea1e8e"
    }
  ],
  "routes": [
    "doomscrll.com/*",
    "www.doomscrll.com/*"
  ],
  "workers_dev": false,
  "preview_urls": false
}
