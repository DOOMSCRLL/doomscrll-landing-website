{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "doomscrll-landing-website",
  "compatibility_date": "2026-05-18",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "main": "dist/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "routes": [
    {
      "pattern": "doomscrll.com",
      "custom_domain": true
    },
    {
      "pattern": "www.doomscrll.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
