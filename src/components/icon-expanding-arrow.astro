---
type Props = {
  direction?: "Left" | "Right"
}

const { direction = "Right" } = Astro.props
---

<span
  role="complementary"
  class:list={[
    "complementary flex h-8 w-full items-center justify-center",
    { "transform-[scaleX(-1)]": direction === "Left" },
  ]}>
  <!-- Arrow Tail: -->
  <span class="arrow-tail h-full w-full bg-secondary group-hover:bg-primary group-active:bg-primary"></span>
  <!-- Arrow Head: -->
  <svg
    viewBox="0 0 24 24"
    class="h-full w-auto flex-none fill-secondary group-hover:fill-primary group-active:fill-primary">
    <path
      d="m16.04 2-2 2a10 10 0 0 0 3.346 6.601H0V13.4h17.386A10 10 0 0 0 14.04 20l2 2.001a10 10 0 0 1 6.837-8.601A10 10 0 0 1 24 13.1v-2.202a10 10 0 0 1-1.123-.298A10 10 0 0 1 16.04 2"
    ></path>
  </svg>
</span>

<style>
  span.arrow-tail {
    mask-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZD0iTTAgMTAuNjAxaDI0djIuNzk3SDB6Ii8+PC9zdmc+Cg==");
    mask-size: auto 100%;
    mask-repeat: repeat-x;
  }
</style>
