---
import Popup from "comps/popup.astro"
import { getDictionaryOf, type Locale } from "repos/locales"
import SlabAnchor from "./slab-anchor.astro"
import SlabButton from "./slab-button.astro"

interface Props {
  locale: Locale
  dialogId: string
}

const { locale, dialogId } = Astro.props

const dict = getDictionaryOf(locale).appPopup
---

<Popup {dialogId}>
  <!--
  <h1 class="font-serif text-4xl tracking-tight text-secondary italic">{dict.header}</h1>
  <p class="font-serif text-xl text-secondary">{dict.copy}</p>

  <a href="#" target="_blank" rel="nofollow noreferrer noopener" class="w-75">
    <img
      src=`/img-assets/google-play-badge-${locale}.svg`
      width="300"
      height="89"
      alt={dict.altTextPlayStore}
      loading="lazy"
      decoding="async"
    />
  </a>
  <a href="#" target="_blank" rel="nofollow noreferrer noopener" class="w-75">
    <img
      src=`/img-assets/app-store-badge-${locale}.svg`
      width="300"
      height="100"
      alt={dict.altTextAppStore}
      loading="lazy"
      decoding="async"
    />
  </a>
  -->

  <header class="flex w-full items-center justify-between">
    <h1 class="font-serif text-4xl tracking-tight text-secondary italic">{dict.header}</h1>
    <SlabButton label="X" fit="min" closesModalId={dialogId} />
  </header>
  <p class="font-serif text-2xl tracking-tight text-secondary">{dict.copyWebapp}</p>
  <SlabAnchor href="https://app.doomscrll.com" label={dict.labelVisitWebapp} />
  <hr class="w-full border-secondary" />
  <footer class="px-4">
    <ul class="list-['*_'] font-serif text-secondary italic">
      <li>{dict.subtextAccount}</li>
      <li>{dict.subtextApps}</li>
    </ul>
  </footer>
</Popup>
