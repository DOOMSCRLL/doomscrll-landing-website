---
type Props = {
  label: string
  fit?: "max" | "min"
  opensModalId?: string
  closesModalId?: string
}

const { label, fit = "max", closesModalId, opensModalId } = Astro.props
---

<button
  data-modal-open={opensModalId}
  data-modal-close={closesModalId}
  class:list={[
    "font-mono font-bold tracking-wider text-primary uppercase",
    "flex items-center justify-center gap-4",
    "h-12 rounded-2xl bg-secondary px-4",
    fit === "max" ? "w-full" : "w-min",
    "not-disabled:hover:bg-secondary/40 not-disabled:active:bg-accent",
    "not-disabled:hover:text-primary not-disabled:active:text-primary",
  ]}>
  {label}
  {fit === "max" && <span class="text-3xl">→</span>}
</button>
