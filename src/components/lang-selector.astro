---
type Props = {
  locale: "en" | "tr"
}

const { locale } = Astro.props

const label = locale === "en" ? "🇹🇷 TÜRKÇE" : "🇺🇸 ENGLISH"
const href = locale === "en" ? "/tr" : "/"
---

<a
  {href}
  class:list={[
    "font-mono font-bold tracking-wider whitespace-nowrap text-secondary uppercase",
    "flex items-center justify-center gap-4",
    "h-12 w-min cursor-pointer rounded-2xl bg-primary px-4",
    "not-disabled:hover:bg-secondary not-disabled:active:bg-accent",
    "not-disabled:hover:text-primary not-disabled:active:text-primary",
  ]}>
  {label}
  <span class="text-2xl">→</span>
</a>
