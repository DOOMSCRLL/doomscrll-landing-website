---
import type ProjectPreview from "models/project-preview"

import DoomscrllLogo from "./doomscrll-logo.astro"
import DoomscrllWordmark from "./doomscrll-wordmark.astro"
import ExpandingArrowButton from "./expanding-arrow-button.astro"

interface Props {
  items: ProjectPreview[]
}

const { items } = Astro.props

const tileCount = items.length + 1
const zRadius = Math.ceil(14 /*rem*/ / 2 / Math.tan(Math.PI / tileCount))
const rotationOffset = 360 / tileCount
---

<section
  id="carousel-container"
  class="hidden h-full w-full flex-col items-center justify-center gap-20 md:flex"
  data-items={JSON.stringify(items)}>
  <!-- Carousel -->
  <section class="relative h-56 w-56 perspective-[2400px]">
    <div
      id="carousel"
      class="absolute h-full w-full pt-6 transition-transform will-change-transform transform-3d motion-reduce:transition-none">
      <div
        class="absolute flex h-56 w-56 items-center justify-center rounded-2xl bg-primary backface-hidden"
        style={`transform: rotateY(0deg) translateZ(${zRadius}rem);`}>
        <DoomscrllLogo size="Full Height" />
      </div>
      {
        items.map((item, index) => (
          <div
            class="absolute h-56 w-56 overflow-hidden rounded-2xl backface-hidden"
            style={`transform: rotateY(${(index + 1) * rotationOffset}deg) translateZ(${zRadius}rem);`}>
            <img
              src={item.imageUrl}
              alt={item.name}
              loading="lazy"
              class="block h-full w-full object-cover object-center"
            />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Interactions -->
  <section class="grid h-min w-full grid-cols-3 gap-16 px-4">
    <ExpandingArrowButton direction="Left" id="btn-carousel-prev" />
    <div class="flex h-full w-full flex-col items-center gap-2">
      <div id="brand-wordmark" class="h-full opacity-60"><DoomscrllWordmark /></div>
      <p id="project-title" class="hidden font-serif text-6xl">DOOMSCROLL</p>
      <p id="project-author" class="font-serif text-xl italic">&#64;_notymc</p>
    </div>
    <ExpandingArrowButton direction="Right" id="btn-carousel-next" />
  </section>
</section>

<script>
  function configCarousel() {
    const wrapper = document.getElementById("carousel-container")
    const carousel = document.getElementById("carousel")

    const wordmark = document.getElementById("brand-wordmark")
    const title = document.getElementById("project-title")
    const author = document.getElementById("project-author")

    const btnPrev = document.getElementById("btn-carousel-prev")
    const btnNext = document.getElementById("btn-carousel-next")

    if (!wrapper || !carousel || !wordmark || !title || !author || !btnPrev || !btnNext) return

    const items = JSON.parse(wrapper.dataset.items!)

    /*const SIZE_FONT_ROOT = parseFloat(getComputedStyle(document.documentElement).fontSize)
    const SIZE_TILE = parseFloat(wrapper.dataset.tileSizeRem!) * SIZE_FONT_ROOT*/
    const COUNT_TILES = items.length + 1
    const OFFSET_ROTATION = 360 / COUNT_TILES

    let itr = 0

    function getActiveIndex() {
      return ((itr % COUNT_TILES) + COUNT_TILES) % COUNT_TILES
    }

    function updateCarousel() {
      if (carousel === null) throw Error("ERROR (configCarousel > updateCarousel): `div.#carousel` is null.")

      carousel.style.transform = `rotateY(${-OFFSET_ROTATION * itr}deg)`
      // const activeIndex = ((iterator % length) + length) % length;
    }

    function updateDetails() {
      if (title === null || wordmark === null || author === null) return

      const activeIndex = getActiveIndex()
      if (activeIndex === 0) {
        title.classList.add("hidden")
        wordmark.classList.remove("hidden")

        author.textContent = "@_notymc"
      } else {
        title.classList.remove("hidden")
        wordmark.classList.add("hidden")

        title.textContent = items[activeIndex].name
        author.textContent = "@" + items[activeIndex].author
      }
    }

    btnNext.addEventListener("click", () => {
      itr++
      updateCarousel()
      updateDetails()
    })
    btnPrev.addEventListener("click", () => {
      itr--
      updateCarousel()
      updateDetails()
    })
  }

  configCarousel()
  document.addEventListener("astro:page-load", configCarousel)
</script>
