---
import type { GetStaticPaths } from "astro"

import AppPopup from "comps/app-popup.astro"
import DoomscrllLogo from "comps/doomscrll-logo.astro"
import FunnelingText from "comps/funneling-text.astro"
import HelpPopup from "comps/help-popup.astro"
import LangSelector from "comps/lang-selector.astro"
import ProjectGalleryWrapper from "comps/project-gallery-wrapper.astro"
import SlabAnchor from "comps/slab-anchor.astro"
import SlabButton from "comps/slab-button.astro"
import StarMark from "comps/star-mark.astro"
import RootLayout from "layouts/root-layout.astro"

import { getDictionaryOf, kDefaultLocale, kLocales } from "repos/locales"

export const getStaticPaths = (() =>
  kLocales.map(locale => ({
    params: { locale: locale === kDefaultLocale ? undefined : locale },
    props: { currentLocale: locale },
  }))) satisfies GetStaticPaths

const { currentLocale } = Astro.props

const dict = getDictionaryOf(currentLocale)

// TODO: Tweak carousel spacing, sizing and perspective
// TODO: Tweak carousel text styling
// TODO: Tweak desktop page layout
// TODO: Change platform badges to point to app store links
// TODO: Add under construction state to platform badges.
---

<RootLayout locale={currentLocale} description={dict.meta.description} title={dict.meta.title}>
  <nav
    class:list={[
      "grid w-full grid-cols-[1fr_auto] items-center px-4",
      "md:grid-cols-[1fr_auto_1fr] md:[&>span]:col-2",
    ]}>
    <DoomscrllLogo size="Small" />
    <section class="flex w-min items-center gap-4 justify-self-end md:col-3">
      <LangSelector locale={currentLocale} />
      <SlabButton label="?" fit="min" opensModalId="help-popup" />
    </section>
  </nav>
  <FunnelingText text={dict.copy} />
  <ProjectGalleryWrapper server:defer />
  <section class="flex flex-col gap-8 px-4 md:flex-row md:gap-6">
    <section class="flex flex-col items-center justify-center gap-4 md:flex-row">
      <p class="font-serif text-xl font-medium tracking-tight">{dict.appFunnel.copy}</p>
      <SlabButton label={dict.appFunnel.cta} opensModalId="app-download-popup" />
    </section>
    <div class="hidden md:block">
      <StarMark />
    </div>
    <section class="flex flex-col items-center justify-center gap-4 md:flex-row">
      <p class="font-serif text-xl font-medium tracking-tight">{dict.doomlitFunnel.copy}</p>
      <SlabAnchor href="https://doomlit.doomscrll.com" label={dict.doomlitFunnel.cta} />
    </section>
  </section>

  <AppPopup locale={currentLocale} dialogId="app-download-popup" />
  <HelpPopup locale={currentLocale} dialogId="help-popup" />
</RootLayout>
