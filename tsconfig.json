{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "allowJs": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strictNullChecks": true,
    "paths": {
      "comps/*": [
        "./src/components/*"
      ],
      "layouts/*": [
        "./src/layouts/*"
      ],
      "repos/*": [
        "./src/repos/*"
      ],
      "styles/*": [
        "./src/styles/*"
      ],
      "utils/*": [
        "./src/utils/*"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}